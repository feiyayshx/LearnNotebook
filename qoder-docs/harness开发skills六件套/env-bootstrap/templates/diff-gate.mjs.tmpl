#!/usr/bin/env node
// diff-gate: staged 文件白名单门禁(env-bootstrap D1-6 生成,跨平台 Node ≥18)
// 用法: 由 .git/hooks/pre-commit 调用 `node scripts/diff-gate.mjs`
// 白名单: .qoder/diff-scope.txt —— 每行一个 glob(支持 * 与 **),# 开头为注释
//   由施工技能维护: deliver-system 按 tasks 文件清单写入;spec-loop-verify 按修复白名单写入;任务结束清空
// 行为: 白名单文件不存在或为空 => 放行并提示(不阻塞日常人工提交)
//       白名单存在 => staged 文件必须全部匹配白名单,越界即退出码 1 拦截提交
// 逃生阀: 确属有意的范围外提交,用 QODER_DIFF_GATE=off 环境变量跳过本次检查(会打印警告,建议在提交说明写明理由)
import { execSync } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";

const SCOPE_FILE = ".qoder/diff-scope.txt";

if (process.env.QODER_DIFF_GATE === "off") {
  console.warn("[diff-gate] SKIPPED via QODER_DIFF_GATE=off — 请在提交说明中写明范围外改动理由");
  process.exit(0);
}

const staged = execSync("git diff --cached --name-only", { encoding: "utf8" })
  .split("\n").map(s => s.trim()).filter(Boolean);
if (staged.length === 0) process.exit(0);

if (!existsSync(SCOPE_FILE)) {
  console.log(`[diff-gate] ${SCOPE_FILE} 不存在,放行(施工任务中应由 deliver-system/spec-loop-verify 写入白名单)`);
  process.exit(0);
}

const globs = readFileSync(SCOPE_FILE, "utf8")
  .split("\n").map(s => s.trim()).filter(s => s && !s.startsWith("#"));
if (globs.length === 0) { console.log("[diff-gate] 白名单为空,放行"); process.exit(0); }

// glob -> RegExp: ** 匹配任意层级, * 匹配单层(不含 /);统一使用 / 分隔符
const toRe = g => new RegExp("^" + g.replace(/[.+^${}()|[\]\\]/g, "\\$&")
  .replace(/\*\*/g, "\u0000").replace(/\*/g, "[^/]*").replace(/\u0000/g, ".*") + "$");
const res = globs.map(toRe);
// 白名单自身、门禁脚本自身与流水线过程制品目录默认放行(过程文档不受施工白名单约束)
const always = [/^\.qoder\//, /^delivery-docs\//, /^docs\//, /^openspec\//].concat([toRe(SCOPE_FILE), toRe("scripts/diff-gate.mjs")]);

const outOfScope = staged.filter(f => {
  const p = f.replace(/\\/g, "/");
  return !res.some(r => r.test(p)) && !always.some(r => r.test(p));
});

if (outOfScope.length > 0) {
  console.error("[diff-gate] ❌ 以下 staged 文件不在本次任务白名单内,提交被拦截:");
  outOfScope.forEach(f => console.error("  - " + f));
  console.error(`[diff-gate] 处理方式: ① 从暂存区移除(git restore --staged <file>) ② 经用户确认后把文件加入 ${SCOPE_FILE} ③ 有意为之则 QODER_DIFF_GATE=off 重试并说明理由`);
  process.exit(1);
}
console.log(`[diff-gate] ✅ ${staged.length} 个 staged 文件全部在白名单内`);
